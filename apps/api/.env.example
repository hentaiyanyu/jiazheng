# 运行环境
NODE_ENV=development
PORT=3000

# 数据库与缓存
DATABASE_URL="mysql://root:root123456@localhost:3306/home_cleaning"
REDIS_URL="redis://localhost:6379"

# 鉴权（生产环境必须改为强随机值）
JWT_SECRET="dev-only-secret-please-change-in-production"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"
# 上传文件签名密钥（不填则回退使用 JWT_SECRET）
FILE_URL_SECRET=""

# 微信小程序（未配置时使用 Mock 登录）
WX_APPID=""
WX_SECRET=""
WX_MOCK="true"

# 微信订阅消息模板 ID（小程序后台申请后填入，留空则只发站内消息）
WX_TEMPLATE_ORDER_STATUS=""
WX_TEMPLATE_DISPATCH=""

# 微信支付（Sprint 2 使用）
WXPAY_MCHID=""
WXPAY_SERIAL_NO=""
WXPAY_PRIVATE_KEY=""
WXPAY_API_V3_KEY=""
WXPAY_NOTIFY_URL=""

# 腾讯位置服务
TENCENT_MAP_KEY=""
