<view class="page">
  <block wx:if="{{order}}">
    <view class="status-card">
      <view class="status-text">{{order.statusText}}</view>
      <view class="status-tip">{{order.status === 'PENDING_PAYMENT' ? '请在 15 分钟内完成支付' : '订单号 ' + order.orderNo}}</view>
    </view>

    <view class="card">
      <view class="section-title">服务信息</view>
      <view class="row">
        <text>{{order.service.name}}</text>
        <text class="muted">{{order.service.skuName}}</text>
      </view>
      <view class="row">
        <text class="muted">服务时间</text>
        <text>{{order.serviceDate}} {{order.startTime}}-{{order.endTime}}</text>
      </view>
      <view class="row">
        <text class="muted">服务地址</text>
        <text class="align-right">{{order.address.district}}{{order.address.detail}}</text>
      </view>
      <view class="row">
        <text class="muted">联系人</text>
        <text>{{order.address.contactName}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{order.staff}}">
      <view class="section-title">服务人员</view>
      <view class="row">
        <text>{{order.staff.name}}</text>
        <text class="muted">评分 {{order.staff.rating}}</text>
      </view>
    </view>

    <view class="card" wx:elif="{{order.status === 'PENDING_DISPATCH'}}">
      <view class="section-title">正在为你匹配服务人员</view>
      <view class="muted">通常几分钟内完成，超时未接单将自动全额退款。</view>
    </view>

    <view class="card">
      <view class="section-title">费用明细</view>
      <view class="row">
        <text class="muted">服务费</text>
        <text>¥{{order.amount.service / 100}}</text>
      </view>
      <view class="row" wx:if="{{order.amount.addon > 0}}">
        <text class="muted">附加项</text>
        <text>¥{{order.amount.addon / 100}}</text>
      </view>
      <view class="row" wx:if="{{order.amount.extra > 0}}">
        <text class="muted">加价项</text>
        <text>¥{{order.amount.extra / 100}}</text>
      </view>
      <view class="row" wx:if="{{order.amount.discount > 0}}">
        <text class="muted">优惠</text>
        <text class="price">-¥{{order.amount.discount / 100}}</text>
      </view>
      <view class="divider"></view>
      <view class="row">
        <text class="section-title" style="margin: 0;">实付</text>
        <text class="price total">¥{{amountText}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{order.remark}}">
      <view class="section-title">备注</view>
      <view class="muted">{{order.remark}}</view>
    </view>

    <view class="card" wx:if="{{order.review}}">
      <view class="section-title">我的评价</view>
      <view class="row">
        <text class="stars">{{order.review.score}} 星</text>
        <text class="muted">{{order.review.isAnonymous ? '匿名评价' : ''}}</text>
      </view>
      <view class="muted" wx:if="{{order.review.tags.length > 0}}" style="margin-top: 8rpx;">
        {{order.review.tags}}
      </view>
      <view class="muted" wx:if="{{order.review.content}}" style="margin-top: 8rpx;">
        {{order.review.content}}
      </view>
    </view>

    <view class="card" wx:if="{{checkinPhoto || finishPhotos.length > 0}}">
      <view class="section-title">服务凭证</view>

      <view wx:if="{{checkinPhoto}}">
        <view class="muted">服务人员到店打卡</view>
        <image class="photo" src="{{checkinPhoto}}" mode="aspectFill" bindtap="onPreviewCheckin" />
      </view>

      <view wx:if="{{finishPhotos.length > 0}}" style="margin-top: 24rpx;">
        <view class="muted">完工照片（{{finishPhotos.length}} 张）</view>
        <view class="photo-list">
          <image
            wx:for="{{finishPhotos}}"
            wx:key="index"
            class="photo"
            src="{{item}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="onPreviewFinish"
          />
        </view>
      </view>
    </view>

    <view class="footer-space"></view>

    <view class="footer">
      <view class="footer-actions">
        <view wx:if="{{canCancel}}" class="btn-ghost" bindtap="onCancel">取消订单</view>
        <view wx:if="{{canRepeat}}" class="btn-ghost" bindtap="onRepeat">再来一单</view>
        <view wx:if="{{canReschedule}}" class="btn-ghost" bindtap="onReschedule">改期</view>
        <view wx:if="{{canReview}}" class="btn-primary btn-sm" bindtap="onReview">去评价</view>
        <view wx:if="{{canConfirm}}" class="btn-primary btn-sm" bindtap="onConfirm">确认完工</view>
        <view wx:if="{{canPay}}" class="btn-primary btn-sm" bindtap="onPay">去支付</view>
      </view>
    </view>
  </block>

  <view wx:else class="empty">加载中…</view>
</view>
