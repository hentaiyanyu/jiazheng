<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">联系人</text>
      <input class="input" placeholder="请输入姓名" value="{{contactName}}" data-field="contactName" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{contactPhone}}" data-field="contactPhone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">所在区</text>
      <picker range="{{districtNames}}" value="{{districtIndex}}" bindchange="onDistrictChange">
        <view class="picker-value">{{districtNames[districtIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">详细地址</text>
      <input class="input" placeholder="小区、楼栋、门牌号" value="{{detail}}" data-field="detail" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">楼层</text>
      <input class="input" type="number" value="{{floor}}" data-field="floor" bindinput="onFloorChange" />
    </view>
    <view class="field">
      <text class="label">有电梯</text>
      <switch checked="{{hasElevator}}" bindchange="onElevatorChange" color="#00b578" />
    </view>
    <view class="field">
      <text class="label">标签</text>
      <input class="input" placeholder="家 / 公司" value="{{tag}}" data-field="tag" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">设为默认</text>
      <switch checked="{{isDefault}}" bindchange="onDefaultChange" color="#00b578" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">定位</view>
    <view class="muted">当前坐标：{{lng}}, {{lat}}</view>
    <view class="btn-secondary" bindtap="onChooseLocation">使用微信地图选点</view>
  </view>

  <view class="footer-space"></view>
  <view class="footer">
    <view class="btn-primary" bindtap="onSave">{{saving ? '保存中…' : '保存地址'}}</view>
  </view>
</view>
