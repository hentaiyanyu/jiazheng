.stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 56rpx;
  color: #e5e6eb;
  margin-right: 12rpx;
}

.star-active {
  color: #ff9500;
}

.score-text {
  margin-left: 12rpx;
  color: #ff9500;
  font-size: 30rpx;
  font-weight: 600;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 14rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 40rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #4e5969;
}

.tag-active {
  background: #e8faf2;
  color: #00b578;
}

.textarea {
  width: 100%;
  height: 180rpx;
  font-size: 28rpx;
  line-height: 44rpx;
}

.anonymous-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f1f3;
}

.footer-space {
  height: 160rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
