<view class="page">
  <view class="card address-card" bindtap="onChooseAddress">
    <block wx:if="{{address}}">
      <view class="row">
        <text class="addr-name">{{address.contactName}}</text>
        <text class="muted">{{address.phoneText}}</text>
      </view>
      <view class="addr-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view>
      <view class="muted">{{address.floor}} 楼 · {{address.hasElevator ? '有电梯' : '无电梯'}}</view>
    </block>
    <block wx:else>
      <view class="addr-empty">+ 添加服务地址</view>
    </block>
  </view>

  <view class="card">
    <view class="section-title">服务内容</view>
    <view class="row">
      <text>{{serviceName}}</text>
      <text class="muted">{{skuName}}</text>
    </view>
    <view wx:if="{{addonNames.length > 0}}" class="row">
      <text class="muted">附加项</text>
      <text class="muted">{{addonNames}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">服务日期</view>
    <scroll-view scroll-x class="dates" enable-flex>
      <view
        wx:for="{{dateOptions}}"
        wx:key="value"
        class="date {{activeDate === item.value ? 'date-active' : ''}}"
        data-date="{{item.value}}"
        bindtap="onSelectDate"
      >
        <view class="date-label">{{item.label}}</view>
        <view class="date-sub">{{item.subLabel}}</view>
      </view>
    </scroll-view>

    <view class="section-title" style="margin-top: 32rpx;">服务时间</view>
    <view class="slots">
      <view
        wx:for="{{slots}}"
        wx:key="startTime"
        class="slot {{item.available ? '' : 'slot-disabled'}} {{startTime === item.startTime ? 'slot-active' : ''}}"
        data-time="{{item.startTime}}"
        bindtap="onSelectSlot"
      >
        <view class="slot-time">{{item.startTime}}</view>
        <view class="slot-tip">{{item.tip}}</view>
      </view>
    </view>
    <view wx:if="{{slots.length === 0}}" class="muted" style="padding: 20rpx 0;">暂无可预约时段</view>
    <view wx:elif="{{noSlotToday}}" class="muted" style="padding: 12rpx 0;">
      该日已无可约时段（已过时或已约满），请选择其他日期
    </view>
    <view wx:elif="{{earliestAvailable && !startTime}}" class="muted" style="padding: 12rpx 0;">
      最早可预约：{{earliestAvailable}}
    </view>
  </view>

  <view class="card" wx:if="{{price}}">
    <view class="section-title">费用明细</view>
    <view class="row" wx:for="{{price.breakdown}}" wx:key="label">
      <text class="muted">{{item.label}}</text>
      <text>{{item.amountText}}</text>
    </view>
    <view class="divider"></view>
    <view class="row">
      <text class="section-title" style="margin: 0;">合计</text>
      <text class="price total">¥{{price.payableText}}</text>
    </view>
    <view class="muted" style="margin-top: 12rpx;">预计服务时长 {{price.durationMinutes}} 分钟</view>
  </view>

  <view class="footer-space"></view>

  <view class="footer">
    <view class="footer-price">
      <text class="muted">应付</text>
      <text class="price total"> ¥{{price ? price.payableText : '--'}}</text>
    </view>
    <view class="btn-primary footer-btn" bindtap="onSubmit">提交订单</view>
  </view>
</view>
